# ==============================================================================
# Environment Configuration for Direct SMTP Email Delivery
# ==============================================================================
# Direct email delivery via your authenticated SMTP provider (e.g. Gmail, Outlook, AWS SES).
# No third-party form services or external hosted handlers.

# SMTP Host (e.g., smtp.gmail.com for Gmail, smtp.office365.com for Outlook)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS/STARTTLS)
SMTP_PORT=465

# SMTP Authentication Username (your full email address)
SMTP_USER=sathwvikmanuri@gmail.com

# SMTP Password or App Password (never share or commit this)
# For Gmail: Enable 2-Step Verification and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_character_app_password_here

# Recipient email address where contact form submissions will be delivered
CONTACT_TO_EMAIL=sathwvikmanuri@gmail.com

# From address used in the SMTP header (must match authenticated SMTP account)
CONTACT_FROM_EMAIL=sathwvikmanuri@gmail.com
